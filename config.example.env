WORKBUDDY_LISTEN=0.0.0.0:8080
WORKBUDDY_API_KEY=replace-with-a-local-api-key
WORKBUDDY_AUTH_FILE=/etc/workbuddy-gateway/auth.json
# Alternatively, set tokens directly instead of WORKBUDDY_AUTH_FILE:
# WORKBUDDY_ACCESS_TOKEN=
# WORKBUDDY_REFRESH_TOKEN=
# WORKBUDDY_USER_ID=
# WORKBUDDY_ENTERPRISE_ID=
# WORKBUDDY_TENANT_ID=
# WORKBUDDY_DOMAIN=
